# Configuration de l'instance du bot
# Copier ce fichier vers storage/<exchange>/.env et renseigner les valeurs

# --- Exchange ---
EXCHANGE=okx                     # Seul exchange supporté : okx (compte européen, my.okx.com)
TRADING_PAIR=BTC/USDC            # Pas d'USDT en Europe (MiCA) : paires USDC ou EUR uniquement
CHECK_INTERVAL_MINUTES=5

# --- Base de données ---
DB_PATH=db/bot.db                # Chemin relatif au répertoire de l'instance

# --- Logs ---
LOG_LEVEL=info                   # debug, info, warn, error
LOG_FILE=db/bot.log              # Fichier de log (vide = stdout uniquement). Requis pour la vue Logs du webui ; db/ est partagé entre bot et webui

# --- Interface web ---
WEB_PORT=:8080                   # Format Go net/http (ex: :8080 ou 0.0.0.0:8080)

# --- API inter-processus (web → bot) ---
BOT_API_URL=http://localhost:9090
BOT_API_PORT=9090
BOT_RELOAD_TOKEN=                # Token secret pour recharger la config depuis le WebUI

# --- Credentials OKX (clé API créée sur my.okx.com : droit « Trade » seul, sans retrait) ---
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=                  # passphrase choisie à la création de la clé
OKX_DEMO=                        # true = « demo trading » (argent fictif, clés de démo) ; vide = réel

# --- Frais ---
# Les cibles de vente sont relevées de l'aller-retour maker (2 × frais) pour que
# profit_target reste une marge NETTE. Vide = tarif réel du compte lu sur OKX.
MAKER_FEE_PCT=                   # ex: 0.08 pour 0,08 %

# --- Notifications Telegram (ou storage/.env.tg partagé entre instances) ---
TELEGRAM=0                       # 1 = activé, 0 = désactivé
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Relay de notifications mobile (sortant uniquement, aucun port à ouvrir) ---
# Vide = désactivé. Le bot pousse ses notifications et un snapshot d'état vers ce
# relay, que consulte l'application mobile ; la réponse au snapshot peut porter
# une commande pause/resume (aucune autre action n'est acceptée).
RELAY_URL=
RELAY_TOKEN=                     # jeton Bearer partagé avec le relay
RELAY_INSTANCE=                  # défaut : la valeur de EXCHANGE
RELAY_INTERVAL_MINUTES=1         # cadence du snapshot (sert de heartbeat)
RELAY_BALANCE_INTERVAL_MINUTES=15 # cadence de la valorisation du portefeuille (appel exchange)

# --- URL de ping à créer sur https://healthchecks.io
HEALTHCHECK_URL=

# --- API-Key Anthropic à créer sur https://platform.claude.com pour activer l'agent IA intégré (Claude Opus 4.8)
ANTHROPIC_API_KEY=
